# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# .env.local wird nie committet (siehe .gitignore).

# ─── Öffentliche Adresse ─────────────────────────────────────────────────────
# Adresse der Website ohne Pfad, z. B. https://www.<vereinsdomain>.de (mit oder
# ohne "www" vor dem Livegang klären). Wird für absolute Vorschaubild-URLs beim
# Teilen (og:image) gebraucht; ohne sie zeigen die Vorschaubilder auf localhost.
# SEITEN_URL=

# ─── Datenbank und Medien ────────────────────────────────────────────────────
# In .env.local gelten die Pfade nur für Next.js: drizzle-kit (npm run db:*) liest
# nur .env, und npm run import:sanity liest gar keine Env-Datei – dort abweichende
# Pfade beim Aufruf setzen (siehe OPERATIONS.md, Abschnitt 2.2).
#
# Optional: Pfad zur SQLite-Datenbank (Standard: data/svhs.db).
# Migrationen aus drizzle/ werden beim ersten Zugriff automatisch eingespielt.
# DATENBANK_PFAD=data/svhs.db

# Optional: Ordner für hochgeladene Bilder und Dateien (Standard: data/medien).
# Ausgeliefert werden sie unter /medien/<pfad>.
# MEDIEN_PFAD=data/medien

# ─── Cron-Jobs ───────────────────────────────────────────────────────────────
# Geheimnis zum Absichern der Cron-Endpunkte /api/cron/sync-fussball und
# /api/cron/sync-tischtennis. Der Aufruf muss den Header
# "Authorization: Bearer <secret>" mitsenden.
# Generieren z. B. mit: openssl rand -base64 32
CRON_SECRET=dein-cron-secret

# ─── Nur für den einmaligen Sanity-Export (scripts/sanity-export.mjs) ────────
# Wird für den Betrieb der Website nicht gebraucht. Nach dem Umzug in die
# Datenbank (npm run export:sanity, danach npm run import:sanity) können diese
# Werte entfernt werden.

# Sanity-Projekt-ID (aus sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=dein-projekt-id

# Sanity-Dataset (Standard: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Lese-Token (Viewer/Read-only) – kein Schreibzugriff nötig
SANITY_API_READ_TOKEN=dein-read-token
