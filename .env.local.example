# ─── Sanity CMS ──────────────────────────────────────────────────────────────
# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# Die Projekt-ID und das Dataset findest du unter https://sanity.io/manage

# Pflicht: Deine Sanity-Projekt-ID (aus sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=dein-projekt-id

# Pflicht: Das Sanity-Dataset (Standard: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: API-Version (ISO-Datum)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: Serverseitiger Read-Token für normale Website-Reads, falls Published-Dokumente
# nicht öffentlich lesbar sind (z. B. mannschaft/person). Kein NEXT_PUBLIC_, nicht im Browser verwenden.
# Typ: Viewer/Read-only mit minimalen Rechten
SANITY_API_READ_TOKEN=dein-read-token

# Nur für Cron, Migrationen und Patch-/Upload-Skripte nötig: Schreib-Token
# (aus Sanity-Projekt-Settings → API → Tokens). Nicht für normale Website-Reads verwenden.
# Typ: Editor oder Administrator
SANITY_API_WRITE_TOKEN=dein-schreib-token

# ─── Cron-Job ────────────────────────────────────────────────────────────────
# Geheimnis zum Absichern des Cron-Endpunkts /api/cron/sync-fussball
# Vercel sendet diesen Wert automatisch als "Authorization: Bearer <secret>"
# Generieren z. B. mit: openssl rand -base64 32
CRON_SECRET=dein-cron-secret
